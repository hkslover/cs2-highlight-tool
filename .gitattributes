# 所有文本文件统一使用 LF，避免 Windows CRLF 警告
* text=auto eol=lf

# Go 源码
*.go text eol=lf

# 前端源码
*.ts text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# 配置文件
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# 二进制文件不做转换
*.exe binary
*.ico binary
*.vpk binary
*.png binary
*.jpg binary

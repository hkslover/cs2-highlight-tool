{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run test:backend:types && npm run test:backend:runtime",
    "test:backend:types": "tsc -p tsconfig.backend-test.json --pretty false",
    "test:backend:runtime": "tsc -p tsconfig.backend-runtime.json --pretty false && node tests/prepare-runtime.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.10",
    "marked": "^18.0.5",
    "naive-ui": "^2.44.1",
    "vfonts": "^0.0.3",
    "vue": "^3.2.37",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@babel/types": "^7.18.10",
    "@vitejs/plugin-vue": "^3.0.3",
    "typescript": "^4.6.4",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^3.0.7",
    "vue-tsc": "^1.8.27"
  }
}
